// One frame of the baked insert clip (the open case and the disc, premultiplied alpha) on a quad just
// past the near plane, over the blurred room (see backdrop.mat and InsertClip in RoomRenderer.kt).
// Compile: matc -p mobile -a opengl -o android/app/src/main/assets/insert_clip.filamat work/materials/insert_clip.mat
material {
    name : InsertClip,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : image, precision : medium }
    ],
    variantFilter : [ skinning, shadowReceiver, vsm, fog, stereo, ssr ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = texture(materialParams_image, getUV0());
    }
}
